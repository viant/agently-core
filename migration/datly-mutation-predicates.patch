+		return nil, err
+	}
+	result.Expression, err = value.(*Context).Expand(group)
+	if err != nil {
+		return nil, err
+	}
+	if strings.TrimSpace(result.Expression) == "" {
+		return nil, nil
+	}
+	return result, nil
