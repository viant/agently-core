#package('github.com/viant/agently-core/internal/datly/toolapprovalqueue/cube')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/tool-approval/report','GET'))
#setting($_ = $input_type('ApprovalReportInput'))
#setting($_ = $output_type('ApprovalReportOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $cube())
#define($_ = $Internal<bool>(approvalAccess/internal).Required())
#define($_ = $VisibilitySubject<*string>(visibility/subject).Required())
#define($_ = $Id<string>(query/id).Optional().WithPredicate(0,'equal','q','id'))
#define($_ = $UserId<string>(query/userId).Optional().WithPredicate(0,'equal','q','user_id'))
#define($_ = $ConversationId<string>(query/conversationId).Optional().WithPredicate(0,'equal','q','conversation_id'))
#define($_ = $TurnId<string>(query/turnId).Optional().WithPredicate(0,'equal','q','turn_id'))
#define($_ = $MessageId<string>(query/messageId).Optional().WithPredicate(0,'equal','q','message_id'))
#define($_ = $ToolName<string>(query/toolName).Optional().WithPredicate(0,'equal','q','tool_name'))
#define($_ = $QueueStatus<string>(query/status).Optional().WithPredicate(0,'equal','q','status'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('reader'))
#define($_ = $Data<[]*ApprovalReportView>(output/view))
SELECT groupable(q), q.user_id,q.conversation_id,q.tool_name,q.status,q.decision,
 COUNT(*) AS total_count,
 COUNT(CASE WHEN q.status='pending' THEN 1 END) AS pending_count,
 COUNT(CASE WHEN LOWER(q.status) IN ('approved','rejected','canceled','executed','failed','timed_out') THEN 1 END) AS outcome_count,
 COUNT(CASE WHEN LOWER(q.status)='timed_out' THEN 1 END) AS timed_out_count,
 type(q,'ApprovalReportView'),
 CAST(q.user_id AS string),tag(q.user_id,'groupable:"true"'),
 CAST(q.conversation_id AS *string),tag(q.conversation_id,'groupable:"true"'),
 CAST(q.tool_name AS string),tag(q.tool_name,'groupable:"true"'),
 CAST(q.status AS string),tag(q.status,'groupable:"true"'),
 CAST(q.decision AS *string),tag(q.decision,'groupable:"true"'),
 CAST(q.total_count AS int),tag(q.total_count,'groupable:"false"'),
 CAST(q.pending_count AS int),tag(q.pending_count,'groupable:"false"'),
 CAST(q.outcome_count AS int),tag(q.outcome_count,'groupable:"false"'),
 CAST(q.timed_out_count AS int),tag(q.timed_out_count,'groupable:"false"')
FROM tool_approval_queue q WHERE ($Internal OR q.user_id=NULLIF($VisibilitySubject,''))
 ${predicate.Builder().CombineOr($predicate.FilterGroup(0,"AND")).Build("AND")}
GROUP BY q.user_id,q.conversation_id,q.tool_name,q.status,q.decision
