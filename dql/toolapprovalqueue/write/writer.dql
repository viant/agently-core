#package('github.com/viant/agently-core/internal/datly/toolapprovalqueue/write')
#import('time','time')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/toolapprovalqueue','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $OrphanDetach<bool>(orphanDetach/enabledDetach).Optional())
#define($_ = $OrphanColumn<string>(orphanDetach/column).Optional())
#define($_ = $Queues<[]*ToolApprovalQueue>(body/data))
#define($_ = $Data<[]*ToolApprovalQueue>(output/body))

SELECT data_rows.id, data_rows.should_delete,
 CAST(data_rows.should_delete AS bool), tag(data_rows.should_delete,'json:",omitempty"'), delete_marker(data_rows.should_delete), delete_not_found(data_rows,'ignore'),
       data_rows.user_id,
       data_rows.conversation_id,
       data_rows.turn_id,
       data_rows.message_id,
       data_rows.tool_name,
       data_rows.title,
       data_rows.arguments,
       data_rows.metadata,
       data_rows.status,
       data_rows.decision,
       data_rows.expires_at,
       data_rows.timed_out_at,
       data_rows.approved_by_user_id,
       data_rows.approved_at,
       data_rows.executed_at,
       data_rows.error_message,
       data_rows.created_at,
       data_rows.updated_at,
       type(data_rows,'ToolApprovalQueue'),
       lifecycle_type(data_rows,'Lifecycle'),
       CAST(data_rows.id AS string),
       tag(data_rows.id,'validate:"required" sqlx:"id,primaryKey"'),
       CAST(data_rows.user_id AS string),
       tag(data_rows.user_id,'validate:"required" sqlx:"user_id"'),
       CAST(data_rows.conversation_id AS *string),
       tag(data_rows.conversation_id,'json:",omitempty" sqlx:"conversation_id"'),
       CAST(data_rows.turn_id AS *string),
       tag(data_rows.turn_id,'json:",omitempty" sqlx:"turn_id"'),
       CAST(data_rows.message_id AS *string),
       tag(data_rows.message_id,'json:",omitempty" sqlx:"message_id"'),
       CAST(data_rows.tool_name AS string),
       tag(data_rows.tool_name,'validate:"required" sqlx:"tool_name"'),
       CAST(data_rows.title AS *string),
       tag(data_rows.title,'json:",omitempty" sqlx:"title"'),
       CAST(data_rows.arguments AS []byte),
       tag(data_rows.arguments,'validate:"required" sqlx:"arguments"'),
       CAST(data_rows.metadata AS *[]byte),
       tag(data_rows.metadata,'json:",omitempty" sqlx:"metadata"'),
       CAST(data_rows.status AS string),
       tag(data_rows.status,'validate:"required" sqlx:"status"'),
       CAST(data_rows.decision AS *string),
       tag(data_rows.decision,'json:",omitempty" sqlx:"decision"'),
       CAST(data_rows.expires_at AS *time.Time),
       tag(data_rows.expires_at,'json:",omitempty" sqlx:"expires_at"'),
       CAST(data_rows.timed_out_at AS *time.Time),
       tag(data_rows.timed_out_at,'json:",omitempty" sqlx:"timed_out_at"'),
       CAST(data_rows.approved_by_user_id AS *string),
       tag(data_rows.approved_by_user_id,'json:",omitempty" sqlx:"approved_by_user_id"'),
       CAST(data_rows.approved_at AS *time.Time),
       tag(data_rows.approved_at,'json:",omitempty" sqlx:"approved_at"'),
       CAST(data_rows.executed_at AS *time.Time),
       tag(data_rows.executed_at,'json:",omitempty" sqlx:"executed_at"'),
       CAST(data_rows.error_message AS *string),
       tag(data_rows.error_message,'json:",omitempty" sqlx:"error_message"'),
       CAST(data_rows.created_at AS *time.Time),
       tag(data_rows.created_at,'json:",omitempty" sqlx:"created_at"'),
       CAST(data_rows.updated_at AS *time.Time),
       tag(data_rows.updated_at,'json:",omitempty" sqlx:"updated_at"')
FROM (SELECT 0 AS should_delete, `id`, `user_id`, `conversation_id`, `turn_id`, `message_id`, `tool_name`, `title`, `arguments`, `metadata`, `status`, `decision`, `expires_at`, `timed_out_at`, `approved_by_user_id`, `approved_at`, `executed_at`, `error_message`, `created_at`, `updated_at` FROM tool_approval_queue) data_rows
