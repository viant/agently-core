#package('github.com/viant/agently-core/internal/datly/legacyrun/read')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/scheduler/legacy-run','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Trusted<bool>(scheduleRunAccess/internal).Required())
#define($_ = $LockRows<bool>(scheduleRunAccess/lock).Optional())
#define($_ = $ID<string>(query/id).Optional().WithPredicate(0,'equal','r','id'))
#define($_ = $IDs<[]string>(query/ids).Optional().WithPredicate(0,'in','r','id'))
#define($_ = $ScheduleID<string>(query/scheduleId).Optional().WithPredicate(0,'equal','r','schedule_id'))
#define($_ = $ScheduleIDs<[]string>(query/scheduleIds).Optional().WithPredicate(0,'in','r','schedule_id'))
#define($_ = $ConversationID<string>(query/conversationId).Optional().WithPredicate(0,'equal','r','conversation_id'))
#define($_ = $ConversationIDs<[]string>(query/conversationIds).Optional().WithPredicate(0,'in','r','conversation_id'))
#define($_ = $Status<string>(query/status).Optional().WithPredicate(0,'equal','r','status'))
#define($_ = $MaintenanceMode<bool>(scheduleRunAccess/maintenance).Optional())
#define($_ = $MaintenanceBefore<time.Time>(query/maintenanceBefore).Optional())
#define($_ = $MaintenanceBeforeSecond<string>(query/maintenanceBeforeSecond).Optional())
#define($_ = $MaintenanceBeforeNano<int64>(query/maintenanceBeforeNano).Optional())
#define($_ = $MaintenanceAfterNano<int64>(query/maintenanceAfterNano).Optional())
#define($_ = $MaintenanceAfterActivity<string>(query/maintenanceAfterActivity).Optional())
#define($_ = $MaintenanceAfterId<string>(query/maintenanceAfterId).Optional())
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('reader'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('reader'))
#define($_ = $Data<[]*LegacyRun>(output/view).WithTag('view:"reader,selectorProjection=true,selectorLimit=true"'))

SELECT data_rows.lease_until_raw,
       CAST(data_rows.lease_until_raw AS *string),internal(data_rows.lease_until_raw),tag(data_rows.lease_until_raw,'json:"-"'),
       data_rows.activity_raw,data_rows.maintenance_owner_id,
       CAST(data_rows.activity_raw AS *string),tag(data_rows.activity_raw,'internal:"true" json:"-"'),
       CAST(data_rows.maintenance_owner_id AS string),tag(data_rows.maintenance_owner_id,'internal:"true" json:"-"'),
       data_rows.id, data_rows.schedule_id, data_rows.created_at, data_rows.updated_at,
       data_rows.status, data_rows.error_message, data_rows.lease_owner, data_rows.lease_until,
       data_rows.precondition_ran_at, data_rows.precondition_passed,
       data_rows.precondition_result, data_rows.conversation_id,
       data_rows.conversation_kind, data_rows.scheduled_for, data_rows.started_at,
       data_rows.completed_at,
       type(data_rows,'LegacyRun'),
       CAST(data_rows.id AS string),
       CAST(data_rows.schedule_id AS string),
       CAST(data_rows.created_at AS time.Time),
       CAST(data_rows.updated_at AS *time.Time),
       CAST(data_rows.status AS string),
       CAST(data_rows.error_message AS *string),
       CAST(data_rows.lease_owner AS *string),
       CAST(data_rows.lease_until AS *time.Time),
       CAST(data_rows.precondition_ran_at AS *time.Time),
       CAST(data_rows.precondition_passed AS *int),
       CAST(data_rows.precondition_result AS *string),
       CAST(data_rows.conversation_id AS *string),
       CAST(data_rows.conversation_kind AS string),
       CAST(data_rows.scheduled_for AS *time.Time),
       CAST(data_rows.started_at AS *time.Time),
       CAST(data_rows.completed_at AS *time.Time)
FROM (
    SELECT r.id, r.schedule_id, r.created_at, r.updated_at,
           r.status, r.error_message, r.lease_owner, r.lease_until,
           r.precondition_ran_at, r.precondition_passed,
           r.precondition_result, r.conversation_id,
           r.conversation_kind, r.scheduled_for, r.started_at,
           r.completed_at,CAST(r.lease_until AS CHAR) AS lease_until_raw,CAST(COALESCE(r.completed_at,r.updated_at,r.created_at) AS CHAR) AS activity_raw,
           TRIM(COALESCE((SELECT s.created_by_user_id FROM schedule s WHERE s.id=r.schedule_id),'')) AS maintenance_owner_id
    FROM schedule_run r
    WHERE $Trusted
    ${predicate.Builder().CombineOr($predicate.FilterGroup(0, "AND")).Build("AND")}
    AND (NOT $MaintenanceMode OR (TRIM(COALESCE(r.schedule_id,''))<>'' AND EXISTS(SELECT 1 FROM schedule s WHERE s.id=r.schedule_id) AND NOT EXISTS(SELECT 1 FROM run current_run WHERE current_run.id=r.id)))
    #if($MaintenanceMode)
    AND (${View.TimestampSecondsUTC("COALESCE(r.completed_at,r.updated_at,r.created_at)")} < $MaintenanceBeforeSecond OR (${View.TimestampSecondsUTC("COALESCE(r.completed_at,r.updated_at,r.created_at)")} = $MaintenanceBeforeSecond AND ${View.TimestampNanoseconds("COALESCE(r.completed_at,r.updated_at,r.created_at)")} <= $MaintenanceBeforeNano))
    #if($Has.MaintenanceAfterId)
    AND (${View.TimestampSecondsUTC("COALESCE(r.completed_at,r.updated_at,r.created_at)")} > $MaintenanceAfterActivity OR (${View.TimestampSecondsUTC("COALESCE(r.completed_at,r.updated_at,r.created_at)")} = $MaintenanceAfterActivity AND (${View.TimestampNanoseconds("COALESCE(r.completed_at,r.updated_at,r.created_at)")} > $MaintenanceAfterNano OR (${View.TimestampNanoseconds("COALESCE(r.completed_at,r.updated_at,r.created_at)")} = $MaintenanceAfterNano AND HEX(r.id)>HEX($MaintenanceAfterId)))))
    #end
    #end
    ORDER BY CASE WHEN $LockRows THEN r.id END,
       
    #if($MaintenanceMode)
       ${View.TimestampSecondsUTC("COALESCE(r.completed_at,r.updated_at,r.created_at)")} ASC,${View.TimestampNanoseconds("COALESCE(r.completed_at,r.updated_at,r.created_at)")} ASC,
    #end
       
       CASE WHEN $MaintenanceMode THEN HEX(r.id) END ASC,
       CASE WHEN NOT $MaintenanceMode THEN r.created_at END,CASE WHEN NOT $MaintenanceMode THEN r.id END
    #if($LockRows) ${View.ForUpdate()} #end
) data_rows
