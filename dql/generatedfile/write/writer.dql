#package('github.com/viant/agently-core/internal/datly/generatedfile/write')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/generated-file','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $writer_omit_empty(true))
#define($_ = $OrphanDetach<bool>(orphanDetach/enabledDetach).Optional())
#define($_ = $OrphanColumn<string>(orphanDetach/column).Optional())
#define($_ = $GeneratedFiles<[]*GeneratedFile>(body/data))
#define($_ = $Data<[]*GeneratedFile>(output/body))

SELECT t.*,
       CAST(t.should_delete AS bool),
       delete_marker(t.should_delete),
       delete_not_found(t,'ignore'),
       type(t,'GeneratedFile'),
       lifecycle_type(t,'Lifecycle'),
       required(t.id),
       tag(t.id,'validate:"required" sqlx:"id,primaryKey"'),
       required(t.conversation_id),
       tag(t.conversation_id,'validate:"required"'),
       required(t.provider),
       tag(t.provider,'validate:"required"'),
       required(t.mode),
       tag(t.mode,'validate:"required"'),
       required(t.copy_mode),
       tag(t.copy_mode,'validate:"required"'),
       required(t.status),
       tag(t.status,'validate:"required"'),
       tag(t.id,'json:","'),
       tag(t.conversation_id,'json:","'),
       tag(t.provider,'json:","'),
       tag(t.mode,'json:","'),
       tag(t.copy_mode,'json:","'),
       tag(t.status,'json:","')
-- Keep the source projection restricted: dedup_key is database-owned and is not a mutable/public field.
FROM (${embed:sql/generatedfile.sql}) t
