#package('github.com/viant/agently-core/internal/datly/modelcall/write')
#import('time','time')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/modelcall','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $OrphanDetach<bool>(orphanDetach/enabledDetach).Optional())
#define($_ = $OrphanColumn<string>(orphanDetach/column).Optional())
#define($_ = $ModelCalls<[]*ModelCall>(body/data))
#define($_ = $Data<[]*ModelCall>(output/body))

SELECT data_rows.message_id, data_rows.should_delete,
       CAST(data_rows.should_delete AS bool), tag(data_rows.should_delete,'json:",omitempty"'), delete_marker(data_rows.should_delete), delete_not_found(data_rows,'ignore'),
       data_rows.turn_id,
       data_rows.provider,
       data_rows.model,
       data_rows.model_kind,
       data_rows.status,
       data_rows.error_code,
       data_rows.error_message,
       data_rows.prompt_tokens,
       data_rows.prompt_cached_tokens,
       data_rows.completion_tokens,
       data_rows.total_tokens,
       data_rows.prompt_audio_tokens,
       data_rows.completion_reasoning_tokens,
       data_rows.completion_audio_tokens,
       data_rows.completion_accepted_prediction_tokens,
       data_rows.completion_rejected_prediction_tokens,
       data_rows.finish_reason,
       data_rows.started_at,
       data_rows.completed_at,
       data_rows.latency_ms,
       data_rows.cost,
       data_rows.trace_id,
       data_rows.span_id,
       data_rows.request_payload_id,
       data_rows.response_payload_id,
       data_rows.provider_request_payload_id,
       data_rows.provider_response_payload_id,
       data_rows.stream_payload_id,
       data_rows.run_id,
       data_rows.iteration,
       type(data_rows,'ModelCall'),
       lifecycle_type(data_rows,'Lifecycle'),
       CAST(data_rows.message_id AS string),
       tag(data_rows.message_id,'validate:"required" sqlx:"message_id,primaryKey"'),
       CAST(data_rows.turn_id AS *string),
       tag(data_rows.turn_id,'json:",omitempty" sqlx:"turn_id"'),
       CAST(data_rows.provider AS string),
       tag(data_rows.provider,'validate:"required" sqlx:"provider"'),
       CAST(data_rows.model AS string),
       tag(data_rows.model,'validate:"required" sqlx:"model"'),
       CAST(data_rows.model_kind AS string),
       tag(data_rows.model_kind,'validate:"required" sqlx:"model_kind"'),
       CAST(data_rows.status AS string),
       tag(data_rows.status,'validate:"required" sqlx:"status"'),
       CAST(data_rows.error_code AS *string),
       tag(data_rows.error_code,'json:",omitempty" sqlx:"error_code"'),
       CAST(data_rows.error_message AS *string),
       tag(data_rows.error_message,'json:",omitempty" sqlx:"error_message"'),
       CAST(data_rows.prompt_tokens AS *int),
       tag(data_rows.prompt_tokens,'json:",omitempty" sqlx:"prompt_tokens"'),
       CAST(data_rows.prompt_cached_tokens AS *int),
       tag(data_rows.prompt_cached_tokens,'json:",omitempty" sqlx:"prompt_cached_tokens"'),
       CAST(data_rows.completion_tokens AS *int),
       tag(data_rows.completion_tokens,'json:",omitempty" sqlx:"completion_tokens"'),
       CAST(data_rows.total_tokens AS *int),
       tag(data_rows.total_tokens,'json:",omitempty" sqlx:"total_tokens"'),
       CAST(data_rows.prompt_audio_tokens AS *int),
       tag(data_rows.prompt_audio_tokens,'json:",omitempty" sqlx:"prompt_audio_tokens"'),
       CAST(data_rows.completion_reasoning_tokens AS *int),
       tag(data_rows.completion_reasoning_tokens,'json:",omitempty" sqlx:"completion_reasoning_tokens"'),
       CAST(data_rows.completion_audio_tokens AS *int),
       tag(data_rows.completion_audio_tokens,'json:",omitempty" sqlx:"completion_audio_tokens"'),
       CAST(data_rows.completion_accepted_prediction_tokens AS *int),
       tag(data_rows.completion_accepted_prediction_tokens,'json:",omitempty" sqlx:"completion_accepted_prediction_tokens"'),
       CAST(data_rows.completion_rejected_prediction_tokens AS *int),
       tag(data_rows.completion_rejected_prediction_tokens,'json:",omitempty" sqlx:"completion_rejected_prediction_tokens"'),
       CAST(data_rows.finish_reason AS *string),
       tag(data_rows.finish_reason,'json:",omitempty" sqlx:"finish_reason"'),
       CAST(data_rows.started_at AS *time.Time),
       tag(data_rows.started_at,'json:",omitempty" sqlx:"started_at"'),
       CAST(data_rows.completed_at AS *time.Time),
       tag(data_rows.completed_at,'json:",omitempty" sqlx:"completed_at"'),
       CAST(data_rows.latency_ms AS *int),
       tag(data_rows.latency_ms,'json:",omitempty" sqlx:"latency_ms"'),
       CAST(data_rows.cost AS *float64),
       tag(data_rows.cost,'json:",omitempty" sqlx:"cost"'),
       CAST(data_rows.trace_id AS *string),
       tag(data_rows.trace_id,'json:",omitempty" sqlx:"trace_id"'),
       CAST(data_rows.span_id AS *string),
       tag(data_rows.span_id,'json:",omitempty" sqlx:"span_id"'),
       CAST(data_rows.request_payload_id AS *string),
       tag(data_rows.request_payload_id,'json:",omitempty" sqlx:"request_payload_id"'),
       CAST(data_rows.response_payload_id AS *string),
       tag(data_rows.response_payload_id,'json:",omitempty" sqlx:"response_payload_id"'),
       CAST(data_rows.provider_request_payload_id AS *string),
       tag(data_rows.provider_request_payload_id,'json:",omitempty" sqlx:"provider_request_payload_id"'),
       CAST(data_rows.provider_response_payload_id AS *string),
       tag(data_rows.provider_response_payload_id,'json:",omitempty" sqlx:"provider_response_payload_id"'),
       CAST(data_rows.stream_payload_id AS *string),
       tag(data_rows.stream_payload_id,'json:",omitempty" sqlx:"stream_payload_id"'),
       CAST(data_rows.run_id AS *string),
       tag(data_rows.run_id,'json:",omitempty" sqlx:"run_id"'),
       CAST(data_rows.iteration AS *int),
       tag(data_rows.iteration,'json:",omitempty" sqlx:"iteration"')
FROM (SELECT 0 AS should_delete, `message_id`, `turn_id`, `provider`, `model`, `model_kind`, `status`, `error_code`, `error_message`, `prompt_tokens`, `prompt_cached_tokens`, `completion_tokens`, `total_tokens`, `prompt_audio_tokens`, `completion_reasoning_tokens`, `completion_audio_tokens`, `completion_accepted_prediction_tokens`, `completion_rejected_prediction_tokens`, `finish_reason`, `started_at`, `completed_at`, `latency_ms`, `cost`, `trace_id`, `span_id`, `request_payload_id`, `response_payload_id`, `provider_request_payload_id`, `provider_response_payload_id`, `stream_payload_id`, `run_id`, `iteration` FROM model_call) data_rows
