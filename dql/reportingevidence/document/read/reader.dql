#package('github.com/viant/agently-core/internal/datly/reportingevidence/document/read')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/reporting-evidence/document','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Owner<string>(query/owner).Required())
#define($_ = $ConversationID<string>(query/conversationId).Required())
#define($_ = $TurnID<string>(query/turnId).Required())
#define($_ = $ID<string>(query/id).Required())
#define($_ = $RunID<string>(query/runId).Required())
#define($_ = $Subtype<string>(query/subtype).Required())
#define($_ = $Data<[]*Document>(output/view))
SELECT documents.*, type(documents,'Document'), CAST(documents.inline_body AS []byte)
FROM (${embed:sql/rows.sql}) documents
