#package('github.com/viant/agently-core/internal/datly/reportingevidence/run/read')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/reporting-evidence/run','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Owner<string>(query/owner).Required())
#define($_ = $ConversationID<string>(query/conversationId).Required())
#define($_ = $TurnID<string>(query/turnId).Required())
#define($_ = $RunID<string>(query/runId).Required())
#define($_ = $Data<[]*Execution>(output/view))
SELECT executions.*, type(executions,'Execution'), row_lock(executions,'run r')
FROM (${embed:sql/rows.sql}) executions
