#package('github.com/viant/agently-core/internal/datly/user/write')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/user','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $writer_omit_empty(true))
#define($_ = $Users<[]*User>(body/data))
#define($_ = $Data<[]*User>(output/body))

SELECT t.*,
       type(t,'User'),
       lifecycle_type(t,'Lifecycle'),
       required(t.id),
       tag(t.id,'validate:"required" sqlx:"id,primaryKey"'),
       required(t.username),
       tag(t.username,'validate:"required"'),
       required(t.provider),
       tag(t.provider,'validate:"required"'),
       tag(t.hash_ip,'json:"-"'),
       required(t.timezone),
       tag(t.timezone,'validate:"required"'),
       tag(t.id,'json:","'),
       tag(t.username,'json:","'),
       tag(t.provider,'json:","'),
       tag(t.timezone,'json:","')
FROM (${embed:sql/user.sql}) t
