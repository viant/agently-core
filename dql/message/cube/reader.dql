#package('github.com/viant/agently-core/internal/datly/message/cube')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/message/report','GET'))
#setting($_ = $input_type('MessageReportInput'))
#setting($_ = $output_type('MessageReportOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $cube())
#define($_ = $Internal<bool>(messageAccess/internal).Required())
#define($_ = $VisibilitySubject<*string>(visibility/subject).Required())
#define($_ = $ConversationId<string>(query/conversationId).Optional().WithPredicate(0,'equal','m','conversation_id'))
#define($_ = $TurnId<string>(query/turnId).Optional().WithPredicate(0,'equal','m','turn_id'))
#define($_ = $Roles<[]string>(query/roles).Optional().WithPredicate(0,'in','m','role'))
#define($_ = $Statuses<[]string>(query/statuses).Optional().WithPredicate(0,'in','m','status'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('reader'))
#define($_ = $Data<[]*MessageReportView>(output/view))
SELECT groupable(m), m.conversation_id,m.role,m.type,m.status,m.phase,m.iteration,
 COUNT(*) AS record_count,
 COUNT(CASE WHEN m.elicitation_id IS NOT NULL AND m.status='pending' THEN 1 END) AS pending_count,
 COUNT(CASE WHEN m.role='user' THEN 1 END) AS user_count,
 COUNT(CASE WHEN m.role='assistant' THEN 1 END) AS assistant_count,
 type(m,'MessageReportView'),
 CAST(m.conversation_id AS string),tag(m.conversation_id,'groupable:"true"'),
 CAST(m.role AS string),tag(m.role,'groupable:"true"'),
 CAST(m.type AS string),tag(m.type,'groupable:"true"'),
 CAST(m.status AS *string),tag(m.status,'groupable:"true"'),
 CAST(m.phase AS *string),tag(m.phase,'groupable:"true"'),
 CAST(m.iteration AS *int),tag(m.iteration,'groupable:"true"'),
 CAST(m.record_count AS int),tag(m.record_count,'groupable:"false"'),
 CAST(m.pending_count AS int),tag(m.pending_count,'groupable:"false"'),
 CAST(m.user_count AS int),tag(m.user_count,'groupable:"false"'),
 CAST(m.assistant_count AS int),tag(m.assistant_count,'groupable:"false"')
FROM message m WHERE ($Internal OR EXISTS(SELECT 1 FROM conversation c WHERE c.id=m.conversation_id
 AND (COALESCE(c.visibility,'')<>'private' OR c.created_by_user_id=NULLIF($VisibilitySubject,''))))
 ${predicate.Builder().CombineOr($predicate.FilterGroup(0,"AND")).Build("AND")}
GROUP BY m.conversation_id,m.role,m.type,m.status,m.phase,m.iteration
