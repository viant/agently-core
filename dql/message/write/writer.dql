#package('github.com/viant/agently-core/internal/datly/message/write')
#import('time','time')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/message','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $OrphanDetach<bool>(orphanDetach/enabledDetach).Optional())
#define($_ = $OrphanColumn<string>(orphanDetach/column).Optional())
#define($_ = $DetachLinks<bool>(messageAccess/detachLinks).Optional())
#define($_ = $TerminalCleanup<bool>(messageAccess/terminalCleanup).Optional())
#define($_ = $DetachMessageIDs<[]string>(messageAccess/messageIds).Optional())
#define($_ = $Messages<[]*Message>(body/data))
#define($_ = $Data<[]*Message>(output/body))

SELECT data_rows.id, data_rows.should_delete,
       CAST(data_rows.should_delete AS bool), tag(data_rows.should_delete,'json:",omitempty"'), delete_marker(data_rows.should_delete), delete_not_found(data_rows,'ignore'),
       sequence_scope(data_rows.sequence, data_rows.turn_id),
       tag(data_rows.sequence,'sequenceOnNull:"allocate"'),
       data_rows.archived,
       data_rows.conversation_id,
       data_rows.turn_id,
       data_rows.sequence,
       data_rows.created_at,
       data_rows.updated_at,
       data_rows.created_by_user_id,
       data_rows.mode,
       data_rows.role,
       data_rows.status,
       data_rows.type,
       data_rows.content,
       data_rows.raw_content,
       data_rows.summary,
       data_rows.context_summary,
       data_rows.embedding_index,
       data_rows.tags,
       data_rows.interim,
       data_rows.elicitation_id,
       data_rows.parent_message_id,
       data_rows.superseded_by,
       data_rows.linked_conversation_id,
       data_rows.tool_name,
       data_rows.preamble AS Narration,
       data_rows.iteration,
       data_rows.phase,
       data_rows.attachment_payload_id,
       data_rows.elicitation_payload_id,
       type(data_rows,'Message'),
       lifecycle_type(data_rows,'Lifecycle'),
       CAST(data_rows.id AS string),
       tag(data_rows.id,'validate:"required" sqlx:"id,primaryKey"'),
       CAST(data_rows.archived AS *int),
       tag(data_rows.archived,'json:",omitempty" sqlx:"archived"'),
       CAST(data_rows.conversation_id AS string),
       tag(data_rows.conversation_id,'validate:"required" sqlx:"conversation_id"'),
       CAST(data_rows.turn_id AS *string),
       tag(data_rows.turn_id,'json:",omitempty" sqlx:"turn_id"'),
       CAST(data_rows.sequence AS *int),
       tag(data_rows.sequence,'json:",omitempty" sqlx:"sequence"'),
       CAST(data_rows.created_at AS *time.Time),
       tag(data_rows.created_at,'json:",omitempty" sqlx:"created_at"'),
       CAST(data_rows.updated_at AS *time.Time),
       tag(data_rows.updated_at,'json:",omitempty" sqlx:"updated_at"'),
       CAST(data_rows.created_by_user_id AS *string),
       tag(data_rows.created_by_user_id,'json:",omitempty" sqlx:"created_by_user_id"'),
       CAST(data_rows.mode AS *string),
       tag(data_rows.mode,'json:",omitempty" sqlx:"mode"'),
       CAST(data_rows.role AS string),
       tag(data_rows.role,'validate:"required" sqlx:"role"'),
       CAST(data_rows.status AS *string),
       tag(data_rows.status,'sqlx:"status"'),
       CAST(data_rows.type AS string),
       tag(data_rows.type,'validate:"required" sqlx:"type"'),
       CAST(data_rows.content AS *string),
       tag(data_rows.content,'sqlx:"content"'),
       CAST(data_rows.raw_content AS *string),
       tag(data_rows.raw_content,'json:",omitempty" sqlx:"raw_content"'),
       CAST(data_rows.summary AS *string),
       tag(data_rows.summary,'json:",omitempty" sqlx:"summary"'),
       CAST(data_rows.context_summary AS *string),
       tag(data_rows.context_summary,'json:",omitempty" sqlx:"context_summary"'),
       CAST(data_rows.embedding_index AS *[]byte),
       tag(data_rows.embedding_index,'json:",omitempty" sqlx:"embedding_index"'),
       CAST(data_rows.tags AS *string),
       tag(data_rows.tags,'json:",omitempty" sqlx:"tags"'),
       CAST(data_rows.interim AS *int),
       tag(data_rows.interim,'json:",omitempty" sqlx:"interim"'),
       CAST(data_rows.elicitation_id AS *string),
       tag(data_rows.elicitation_id,'json:",omitempty" sqlx:"elicitation_id"'),
       CAST(data_rows.parent_message_id AS *string),
       tag(data_rows.parent_message_id,'json:",omitempty" sqlx:"parent_message_id"'),
       CAST(data_rows.superseded_by AS *string),
       tag(data_rows.superseded_by,'json:",omitempty" sqlx:"superseded_by"'),
       CAST(data_rows.linked_conversation_id AS *string),
       tag(data_rows.linked_conversation_id,'json:",omitempty" sqlx:"linked_conversation_id"'),
       CAST(data_rows.tool_name AS *string),
       tag(data_rows.tool_name,'json:",omitempty" sqlx:"tool_name"'),
       CAST(data_rows.Narration AS *string),
       tag(data_rows.Narration,'json:",omitempty" sqlx:"preamble"'),
       CAST(data_rows.iteration AS *int),
       tag(data_rows.iteration,'json:",omitempty" sqlx:"iteration"'),
       CAST(data_rows.phase AS *string),
       tag(data_rows.phase,'json:",omitempty" sqlx:"phase"'),
       CAST(data_rows.attachment_payload_id AS *string),
       tag(data_rows.attachment_payload_id,'json:",omitempty" sqlx:"attachment_payload_id"'),
       CAST(data_rows.elicitation_payload_id AS *string),
       tag(data_rows.elicitation_payload_id,'json:",omitempty" sqlx:"elicitation_payload_id"')
FROM (SELECT 0 AS should_delete, `id`, `archived`, `conversation_id`, `turn_id`, `sequence`, `created_at`, `updated_at`, `created_by_user_id`, `mode`, `role`, `status`, `type`, `content`, `raw_content`, `summary`, `context_summary`, `embedding_index`, `tags`, `interim`, `elicitation_id`, `parent_message_id`, `superseded_by`, `linked_conversation_id`, `tool_name`, `preamble`, `iteration`, `phase`, `attachment_payload_id`, `elicitation_payload_id` FROM message) data_rows
