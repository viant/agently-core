#package('github.com/viant/agently-core/internal/datly/conversationaudit/count')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/conversation-audit/count','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Allowed<bool>(auditaccess/allowed).Required())
#define($_ = $OwnerID<string>(auditaccess/owner).Required())
#define($_ = $OwnerIDContains<string>(auditaccess/ownerContains).Required())
#define($_ = $ConversationID<string>(query/conversationId).Required())
#define($_ = $From<string>(query/from).Required())
#define($_ = $To<string>(query/to).Required())
#define($_ = $Data<[]*Row>(output/view))

SELECT reader.total_count,
       CAST(reader.total_count AS int64),
       type(reader,'Row')
FROM (${embed:sql/reader.sql}) reader
