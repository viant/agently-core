#package('github.com/viant/agently-core/internal/datly/conversationaudit/read')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/conversation-audit','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Allowed<bool>(auditaccess/allowed).Required())
#define($_ = $OwnerID<string>(auditaccess/owner).Required())
#define($_ = $OwnerIDContains<string>(auditaccess/ownerContains).Required())
#define($_ = $ConversationID<string>(query/conversationId).Required())
#define($_ = $From<string>(query/from).Required())
#define($_ = $To<string>(query/to).Required())
#define($_ = $TurnID<string>(query/turnId).Required())
#define($_ = $TurnIDs<[]string>(query/turnIds).Optional().WithPredicate(0,'in','t','id'))
#define($_ = $CursorTime<time.Time>(query/cursorTime).Required())
#define($_ = $CursorID<string>(query/cursorId).Required())
#define($_ = $Detail<bool>(query/detail).Required())
#define($_ = $Limit<int>(query/limit).Required().QuerySelector('reader'))
#define($_ = $Data<[]*Row>(output/view).WithTag('view:"reader,selectorLimit=true"'))

