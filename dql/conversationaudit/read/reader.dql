FROM (${embed:sql/reader.sql}) reader
LEFT JOIN (${embed:sql/run.sql}) runs ON runs.turn_id = reader.id
LEFT JOIN (${embed:sql/message.sql}) message ON message.turn_id = reader.id
LEFT JOIN (${embed:sql/model.sql}) modelCall ON modelCall.message_id = message.id AND 1=1
LEFT JOIN (${embed:sql/tool.sql}) messageToolCall ON messageToolCall.message_id = message.id AND 1=1
