#package('github.com/viant/agently-core/internal/datly/run/write')
#import('time','time')
#import('predicate','github.com/viant/agently-core/internal/datly/predicate')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/run','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $OrphanDetach<bool>(orphanDetach/enabledDetach).Optional())
#define($_ = $OrphanColumn<string>(orphanDetach/column).Optional())
#define($_ = $LeaseMode<string>(query/leaseMode).Optional())
#define($_ = $LeaseOwner<string>(query/leaseOwner).Optional())
#define($_ = $LeaseNow<time.Time>(query/leaseNow).Optional())
#define($_ = $LeaseResult<bool>(output/leaseResult))
#define($_ = $Expectations<[]*predicate.RunExpected>(transient/expectations).Optional().WithPredicate(7,'handler','predicate.RunPredicate'))
#define($_ = $Runs<[]*MutableRunView>(body/data))
#define($_ = $Data<[]*MutableRunView>(output/body))

SELECT data_rows.id, data_rows.should_delete, data_rows.condition,
       CAST(data_rows.should_delete AS bool), tag(data_rows.should_delete,'json:",omitempty"'), delete_marker(data_rows.should_delete), delete_not_found(data_rows,'ignore'),
       CAST(data_rows.condition AS *predicate.RunPatchCondition), tag(data_rows.condition,'sqlx:"-" json:",omitempty"'),
       data_rows.turn_id,
       data_rows.schedule_id,
       data_rows.conversation_id,
       data_rows.conversation_kind,
       data_rows.attempt,
       data_rows.resumed_from_run_id,
       data_rows.status,
       data_rows.error_code,
       data_rows.error_message,
       data_rows.iteration,
       data_rows.max_iterations,
       data_rows.checkpoint_response_id,
       data_rows.checkpoint_message_id,
       data_rows.checkpoint_data,
       data_rows.agent_id,
       data_rows.model_provider,
       data_rows.model,
       data_rows.worker_id,
       data_rows.worker_pid,
       data_rows.worker_host,
       data_rows.lease_owner,
       data_rows.lease_until,
       data_rows.last_heartbeat_at,
       data_rows.security_context,
       data_rows.user_cred_url,
       data_rows.effective_user_id,
       data_rows.auth_authority,
       data_rows.auth_audience,
       data_rows.heartbeat_interval_sec,
       data_rows.scheduled_for,
       data_rows.precondition_ran_at,
       data_rows.precondition_passed,
       data_rows.precondition_result,
       data_rows.usage_prompt_tokens,
       data_rows.usage_completion_tokens,
       data_rows.usage_total_tokens,
       data_rows.usage_cost,
       data_rows.created_at,
       data_rows.updated_at,
       data_rows.started_at,
       data_rows.completed_at,
       type(data_rows,'MutableRunView'), mutation_predicate(data_rows,7),
       lifecycle_type(data_rows,'Lifecycle'),
       CAST(data_rows.id AS string),
       tag(data_rows.id,'validate:"required" sqlx:"id,primaryKey"'),
       CAST(data_rows.turn_id AS *string),
       tag(data_rows.turn_id,'json:",omitempty" sqlx:"turn_id"'),
       CAST(data_rows.schedule_id AS *string),
       tag(data_rows.schedule_id,'json:",omitempty" sqlx:"schedule_id"'),
       CAST(data_rows.conversation_id AS *string),
       tag(data_rows.conversation_id,'json:",omitempty" sqlx:"conversation_id"'),
       CAST(data_rows.conversation_kind AS *string),
       tag(data_rows.conversation_kind,'json:",omitempty" sqlx:"conversation_kind"'),
       CAST(data_rows.attempt AS *int),
       tag(data_rows.attempt,'json:",omitempty" sqlx:"attempt"'),
       CAST(data_rows.resumed_from_run_id AS *string),
       tag(data_rows.resumed_from_run_id,'json:",omitempty" sqlx:"resumed_from_run_id"'),
       CAST(data_rows.status AS string),
       tag(data_rows.status,'validate:"required" sqlx:"status"'),
       CAST(data_rows.error_code AS *string),
       tag(data_rows.error_code,'json:",omitempty" sqlx:"error_code"'),
       CAST(data_rows.error_message AS *string),
       tag(data_rows.error_message,'json:",omitempty" sqlx:"error_message"'),
       CAST(data_rows.iteration AS *int),
       tag(data_rows.iteration,'json:",omitempty" sqlx:"iteration"'),
       CAST(data_rows.max_iterations AS *int),
       tag(data_rows.max_iterations,'json:",omitempty" sqlx:"max_iterations"'),
       CAST(data_rows.checkpoint_response_id AS *string),
       tag(data_rows.checkpoint_response_id,'json:",omitempty" sqlx:"checkpoint_response_id"'),
       CAST(data_rows.checkpoint_message_id AS *string),
       tag(data_rows.checkpoint_message_id,'json:",omitempty" sqlx:"checkpoint_message_id"'),
       CAST(data_rows.checkpoint_data AS *string),
       tag(data_rows.checkpoint_data,'json:",omitempty" sqlx:"checkpoint_data"'),
       CAST(data_rows.agent_id AS *string),
       tag(data_rows.agent_id,'json:",omitempty" sqlx:"agent_id"'),
       CAST(data_rows.model_provider AS *string),
       tag(data_rows.model_provider,'json:",omitempty" sqlx:"model_provider"'),
       CAST(data_rows.model AS *string),
       tag(data_rows.model,'json:",omitempty" sqlx:"model"'),
       CAST(data_rows.worker_id AS *string),
       tag(data_rows.worker_id,'json:",omitempty" sqlx:"worker_id"'),
       CAST(data_rows.worker_pid AS *int),
       tag(data_rows.worker_pid,'json:",omitempty" sqlx:"worker_pid"'),
       CAST(data_rows.worker_host AS *string),
       tag(data_rows.worker_host,'json:",omitempty" sqlx:"worker_host"'),
       CAST(data_rows.lease_owner AS *string),
       tag(data_rows.lease_owner,'json:",omitempty" sqlx:"lease_owner"'),
       CAST(data_rows.lease_until AS *time.Time),
       tag(data_rows.lease_until,'json:",omitempty" sqlx:"lease_until"'),
       CAST(data_rows.last_heartbeat_at AS *time.Time),
       tag(data_rows.last_heartbeat_at,'json:",omitempty" sqlx:"last_heartbeat_at"'),
       CAST(data_rows.security_context AS *string),
       tag(data_rows.security_context,'json:",omitempty" sqlx:"security_context"'),
       CAST(data_rows.user_cred_url AS *string),
