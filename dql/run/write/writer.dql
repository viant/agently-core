       CAST(data_rows.effective_user_id AS *string),
       tag(data_rows.effective_user_id,'json:",omitempty" sqlx:"effective_user_id"'),
       CAST(data_rows.auth_authority AS *string),
       tag(data_rows.auth_authority,'json:",omitempty" sqlx:"auth_authority"'),
       CAST(data_rows.auth_audience AS *string),
       tag(data_rows.auth_audience,'json:",omitempty" sqlx:"auth_audience"'),
       CAST(data_rows.heartbeat_interval_sec AS *int),
       tag(data_rows.heartbeat_interval_sec,'json:",omitempty" sqlx:"heartbeat_interval_sec"'),
       CAST(data_rows.scheduled_for AS *time.Time),
       tag(data_rows.scheduled_for,'json:",omitempty" sqlx:"scheduled_for"'),
       CAST(data_rows.precondition_ran_at AS *time.Time),
       tag(data_rows.precondition_ran_at,'json:",omitempty" sqlx:"precondition_ran_at"'),
       CAST(data_rows.precondition_passed AS *int),
       tag(data_rows.precondition_passed,'json:",omitempty" sqlx:"precondition_passed"'),
       CAST(data_rows.precondition_result AS *string),
       tag(data_rows.precondition_result,'json:",omitempty" sqlx:"precondition_result"'),
       CAST(data_rows.usage_prompt_tokens AS *int),
       tag(data_rows.usage_prompt_tokens,'json:",omitempty" sqlx:"usage_prompt_tokens"'),
       CAST(data_rows.usage_completion_tokens AS *int),
