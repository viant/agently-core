       CAST(data_rows.usage_cost AS *float64),
       tag(data_rows.usage_cost,'json:",omitempty" sqlx:"usage_cost"'),
       CAST(data_rows.created_at AS *time.Time),
       tag(data_rows.created_at,'json:",omitempty" sqlx:"created_at"'),
       CAST(data_rows.updated_at AS *time.Time),
       tag(data_rows.updated_at,'json:",omitempty" sqlx:"updated_at"'),
       CAST(data_rows.started_at AS *time.Time),
       tag(data_rows.started_at,'json:",omitempty" sqlx:"started_at"'),
       CAST(data_rows.completed_at AS *time.Time),
       tag(data_rows.completed_at,'json:",omitempty" sqlx:"completed_at"')
FROM (SELECT NULL AS `condition`, 0 AS should_delete, `id`, `turn_id`, `schedule_id`, `conversation_id`, `conversation_kind`, `attempt`, `resumed_from_run_id`, `status`, `error_code`, `error_message`, `iteration`, `max_iterations`, `checkpoint_response_id`, `checkpoint_message_id`, `checkpoint_data`, `agent_id`, `model_provider`, `model`, `worker_id`, `worker_pid`, `worker_host`, `lease_owner`, `lease_until`, `last_heartbeat_at`, `security_context`, `user_cred_url`, `effective_user_id`, `auth_authority`, `auth_audience`, `heartbeat_interval_sec`, `scheduled_for`, `precondition_ran_at`, `precondition_passed`, `precondition_result`, `usage_prompt_tokens`, `usage_completion_tokens`, `usage_total_tokens`, `usage_cost`, `created_at`, `updated_at`, `started_at`, `completed_at` FROM run) data_rows
