#package('github.com/viant/agently-core/internal/datly/payload/reference')
#import('time','time')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v2/api/agently/payload','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Status<?>(output/status).WithTag('anonymous:"true"'))
#define($_ = $Metrics<?>(output/metrics))
#define($_ = $CheckReferences<bool>(payloadAccess/checkReferences).Optional())
#define($_ = $TenantID<string>(path/tenantId).Optional().WithPredicate(0,'in','p','tenant_id'))
#define($_ = $Id<string>(query/id).Optional().WithPredicate(0,'in','p','id'))
#define($_ = $Ids<[]string>(query/ids).Optional().WithPredicate(0,'in','p','id'))
#define($_ = $Kind<string>(query/kind).Optional().WithPredicate(0,'in','p','kind'))
#define($_ = $Digest<string>(query/digest).Optional().WithPredicate(0,'in','p','digest'))
#define($_ = $Storage<string>(query/storage).Optional().WithPredicate(0,'in','p','storage'))
#define($_ = $MimeType<string>(query/mime_type).Optional().WithPredicate(0,'in','p','mime_type'))
#define($_ = $Since<*time.Time>(query/since).Optional().WithPredicate(0,'greater_or_equal','p','created_at'))
#define($_ = $Fields<[]string>(query/_fields).Optional().QuerySelector('reader'))
#define($_ = $OrderBy<string>(query/_orderBy).Optional().QuerySelector('reader'))
#define($_ = $Limit<int>(query/_limit).Optional().QuerySelector('reader'))
#define($_ = $Offset<int>(query/_offset).Optional().QuerySelector('reader'))
#define($_ = $Page<int>(query/_page).Optional().QuerySelector('reader'))
#define($_ = $Criteria<string>(query/_criteria).Optional().QuerySelector('reader'))
#define($_ = $Data<[]*PayloadView>(output/view))

SELECT payload.id, payload.referenced,
       CAST(payload.referenced AS bool), internal(payload.referenced), tag(payload.referenced,'json:"-"'),
       payload.tenant_id,
       payload.kind,
       payload.subtype,
       payload.mime_type,
       payload.size_bytes,
       payload.digest,
       payload.storage,
       payload.inline_body,
       payload.uri,
       payload.compression,
       payload.encryption_kms_key_id,
       payload.redaction_policy_version,
       payload.redacted,
       payload.created_at,
       payload.schema_ref,
       type(payload,'PayloadView'),
       allowed_order_by_columns(payload,'id,created_at,size_bytes'),
       CAST(payload.id AS string),
       CAST(payload.tenant_id AS *string),
       CAST(payload.kind AS string),
       CAST(payload.subtype AS *string),
       CAST(payload.mime_type AS string),
       CAST(payload.size_bytes AS int),
       CAST(payload.digest AS *string),
       CAST(payload.storage AS string),
       CAST(payload.inline_body AS *[]byte),
       CAST(payload.uri AS *string),
       CAST(payload.compression AS string),
       CAST(payload.encryption_kms_key_id AS *string),
       CAST(payload.redaction_policy_version AS *string),
       CAST(payload.redacted AS *int),
       CAST(payload.created_at AS *time.Time),
       CAST(payload.schema_ref AS *string)
FROM (
SELECT
  p.id,
  CASE WHEN $CheckReferences AND (
    EXISTS (SELECT 1 FROM message WHERE attachment_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM message WHERE elicitation_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM model_call WHERE request_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM model_call WHERE response_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM model_call WHERE provider_request_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM model_call WHERE provider_response_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM model_call WHERE stream_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM tool_call WHERE request_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM tool_call WHERE response_payload_id=p.id) OR
    EXISTS (SELECT 1 FROM generated_file WHERE payload_id=p.id)
  ) THEN 1 ELSE 0 END AS referenced,
  p.tenant_id,
  p.kind,
  p.subtype,
  p.mime_type,
  p.size_bytes,
  p.digest,
  p.storage,
  p.inline_body,
  p.uri,
  p.compression,
  p.encryption_kms_key_id,
  p.redaction_policy_version,
  p.redacted,
  p.created_at,
  p.schema_ref
FROM call_payload p
${predicate.Builder().CombineOr($predicate.FilterGroup(0, "AND")).Build("WHERE")}
) payload
