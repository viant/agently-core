#package('github.com/viant/agently-core/internal/datly/turnqueue/write')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/turnqueue','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Queues<[]*TurnQueue>(body/data))
#define($_ = $Data<[]*TurnQueue>(output/body))

SELECT t.*,
       CAST(t.should_delete AS bool),
       tag(t.should_delete,'json:",omitempty"'),
       delete_marker(t.should_delete),
       delete_not_found(t,'ignore'),
       type(t,'TurnQueue'),
       lifecycle_type(t,'Lifecycle'),
       required(t.id),
       tag(t.id,'validate:"required" sqlx:"id,primaryKey"'),
       required(t.conversation_id),
       required(t.turn_id),
       required(t.message_id),
       CAST(t.queue_seq AS *int64),
       tag(t.queue_seq,'json:",omitempty"'),
       required(t.status),
       tag(t.created_at,'json:",omitempty"'),
       tag(t.updated_at,'json:",omitempty"')
FROM (${embed:sql/turnqueue.sql}) t
