#package('github.com/viant/agently-core/internal/datly/agui/cleanup/event/read')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/ag-ui/cleanup/event','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Trusted<bool>(conversationtreeScope/internal).Required())
#define($_ = $ThreadIDs<[]string>(query/threadIds).Required().WithPredicate(0,'in','c','conversation_id'))
#define($_ = $Data<[]*Event>(output/view))
SELECT agui_data.*,
       agui_data.id AS EventKey,
       agui_data.run_id AS RunKey,
       agui_data.conversation_id AS ThreadId,
       agui_data.protocol_run_id AS RunId,
       type(agui_data,'Event'),
       tag(agui_data.EventKey,'sqlx:"id,primaryKey=true,required=true"'),
       row_lock(agui_data,'call_payload p'),
       set_limit(agui_data,0),
       CAST(agui_data.RunId AS string),
       CAST(agui_data.sequence AS int64)
FROM (${embed:sql/rows.sql}) agui_data
