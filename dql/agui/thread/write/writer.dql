#package('github.com/viant/agently-core/internal/datly/agui/thread/write')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/ag-ui/thread','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Principal<string>(query/principal).Required().WithPredicate(7,'equal','conversation','created_by_user_id'))
#define($_ = $Mode<string>(query/mode).Required())
#define($_ = $DesiredRevision<int64>(query/desiredRevision).Optional())
#define($_ = $Rows<[]*Thread>(body/data))
#define($_ = $Data<[]*Thread>(output/body))
SELECT agui_data.*,
       agui_data.protocol_thread_key AS ThreadKey,
       agui_data.protocol_thread_id AS ThreadId,
       agui_data.protocol_principal AS Principal,
       agui_data.protocol_revision AS Revision,
       agui_data.protocol_state_json AS StateJson,
       agui_data.protocol_messages_json AS MessagesJson,
       type(agui_data,'Thread'),
       tag(agui_data.id,'sqlx:"id,primaryKey=true,required=true"'),
       lifecycle_type(agui_data,'Lifecycle'),
       concurrency_token(agui_data.Revision),
       mutation_predicate(agui_data,7),
       CAST(agui_data.ThreadId AS *string),
       CAST(agui_data.Principal AS *string),
       CAST(agui_data.Revision AS int64),
       CAST(agui_data.StateJson AS []byte),
       CAST(agui_data.MessagesJson AS []byte),
       CAST(agui_data.protocol_only AS bool)
FROM (${embed:sql/rows.sql}) agui_data
