#package('github.com/viant/agently-core/internal/datly/agui/event/write')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/ag-ui/event','POST'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Rows<[]*Event>(body/data))
#define($_ = $Data<[]*Event>(output/body))
SELECT agui_data.*,
       agui_data.id AS EventKey,
       agui_data.run_id AS RunKey,
       agui_data.inline_body AS EventJson,
       type(agui_data,'Event'),
       tag(agui_data.EventKey,'sqlx:"id,primaryKey=true,required=true"'),
       lifecycle_type(agui_data,'Lifecycle'),
       CAST(agui_data.sequence AS int64),
       CAST(agui_data.EventJson AS []byte)
FROM (${embed:sql/rows.sql}) agui_data
