#package('github.com/viant/agently-core/internal/datly/agui/event/read')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/agently/ag-ui/event','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Principal<string>(query/principal).Required())
#define($_ = $RunKey<string>(query/runKey).Required())
#define($_ = $After<int64>(query/after).Required())
#define($_ = $Limit<int>(query/limit).Required())
#define($_ = $Data<[]*Event>(output/view))
SELECT agui_data.*,
       agui_data.id AS EventKey,
       agui_data.run_id AS RunKey,
       agui_data.inline_body AS EventJson,
       agui_data.protocol_run_id AS RunId,
       agui_data.protocol_thread_id AS ThreadId,
       type(agui_data,'Event'),
       tag(agui_data.EventKey,'sqlx:"id,primaryKey=true,required=true"'),
       set_limit(agui_data,1000),
       CAST(agui_data.EventJson AS []byte),
       CAST(agui_data.sequence AS int64),
       CAST(agui_data.RunId AS string),
       CAST(agui_data.ThreadId AS string)
FROM (${embed:sql/rows.sql}) agui_data
