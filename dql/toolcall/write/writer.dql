#package('github.com/viant/agently-core/internal/datly/toolcall/write')
#import('time','time')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/toolcall','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $OrphanDetach<bool>(orphanDetach/enabledDetach).Optional())
#define($_ = $OrphanColumn<string>(orphanDetach/column).Optional())
#define($_ = $ToolCalls<[]*ToolCall>(body/data))
#define($_ = $Data<[]*ToolCall>(output/body))

SELECT data_rows.message_id, data_rows.should_delete, data_rows.response_overflow,
       CAST(data_rows.should_delete AS bool), tag(data_rows.should_delete,'json:",omitempty"'), delete_marker(data_rows.should_delete), delete_not_found(data_rows,'ignore'),
       CAST(data_rows.response_overflow AS bool), tag(data_rows.response_overflow,'sqlx:"-" json:",omitempty"'),
       data_rows.turn_id,
       data_rows.op_id,
       data_rows.attempt,
       data_rows.tool_name,
       data_rows.tool_kind,
       data_rows.status,
       data_rows.request_hash,
       data_rows.error_code,
       data_rows.error_message,
       data_rows.retriable,
       data_rows.started_at,
       data_rows.completed_at,
       data_rows.latency_ms,
       data_rows.cost,
       data_rows.trace_id,
       data_rows.span_id,
       data_rows.request_payload_id,
       data_rows.response_payload_id,
       data_rows.run_id,
       data_rows.iteration,
       type(data_rows,'ToolCall'),
       lifecycle_type(data_rows,'Lifecycle'),
       CAST(data_rows.message_id AS string),
       tag(data_rows.message_id,'validate:"required" sqlx:"message_id,primaryKey"'),
       CAST(data_rows.turn_id AS *string),
       tag(data_rows.turn_id,'json:",omitempty" sqlx:"turn_id"'),
       CAST(data_rows.op_id AS string),
       tag(data_rows.op_id,'validate:"required" sqlx:"op_id"'),
       CAST(data_rows.attempt AS int),
       tag(data_rows.attempt,'sqlx:"attempt"'),
       CAST(data_rows.tool_name AS string),
       tag(data_rows.tool_name,'validate:"required" sqlx:"tool_name"'),
       CAST(data_rows.tool_kind AS string),
       tag(data_rows.tool_kind,'validate:"required" sqlx:"tool_kind"'),
       CAST(data_rows.status AS string),
       tag(data_rows.status,'validate:"required" sqlx:"status"'),
       CAST(data_rows.request_hash AS *string),
       tag(data_rows.request_hash,'json:",omitempty" sqlx:"request_hash"'),
       CAST(data_rows.error_code AS *string),
       tag(data_rows.error_code,'json:",omitempty" sqlx:"error_code"'),
       CAST(data_rows.error_message AS *string),
       tag(data_rows.error_message,'json:",omitempty" sqlx:"error_message"'),
       CAST(data_rows.retriable AS *int),
       tag(data_rows.retriable,'json:",omitempty" sqlx:"retriable"'),
       CAST(data_rows.started_at AS *time.Time),
       tag(data_rows.started_at,'json:",omitempty" sqlx:"started_at"'),
       CAST(data_rows.completed_at AS *time.Time),
       tag(data_rows.completed_at,'json:",omitempty" sqlx:"completed_at"'),
       CAST(data_rows.latency_ms AS *int),
       tag(data_rows.latency_ms,'json:",omitempty" sqlx:"latency_ms"'),
       CAST(data_rows.cost AS *float64),
       tag(data_rows.cost,'json:",omitempty" sqlx:"cost"'),
       CAST(data_rows.trace_id AS *string),
       tag(data_rows.trace_id,'json:",omitempty" sqlx:"trace_id"'),
       CAST(data_rows.span_id AS *string),
       tag(data_rows.span_id,'json:",omitempty" sqlx:"span_id"'),
       CAST(data_rows.request_payload_id AS *string),
       tag(data_rows.request_payload_id,'sqlx:"request_payload_id"'),
       CAST(data_rows.response_payload_id AS *string),
       tag(data_rows.response_payload_id,'sqlx:"response_payload_id"'),
       CAST(data_rows.run_id AS *string),
       tag(data_rows.run_id,'json:",omitempty" sqlx:"run_id"'),
       CAST(data_rows.iteration AS *int),
       tag(data_rows.iteration,'json:",omitempty" sqlx:"iteration"')
FROM (SELECT 0 AS should_delete, 0 AS response_overflow, `message_id`, `turn_id`, `op_id`, `attempt`, `tool_name`, `tool_kind`, `status`, `request_hash`, `error_code`, `error_message`, `retriable`, `started_at`, `completed_at`, `latency_ms`, `cost`, `trace_id`, `span_id`, `request_payload_id`, `response_payload_id`, `run_id`, `iteration` FROM tool_call) data_rows
