#package('github.com/viant/agently-core/internal/datly/conversation/write')
#import('time','time')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/conversation','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $OrphanDetach<bool>(orphanDetach/enabledDetach).Optional())
#define($_ = $OrphanColumn<string>(orphanDetach/column).Optional())
#define($_ = $Conversations<[]*MutableConversationView>(body/data))
#define($_ = $Data<[]*MutableConversationView>(output/body))

SELECT data_rows.id,
       data_rows.should_delete,
       CAST(data_rows.should_delete AS bool), tag(data_rows.should_delete,'json:",omitempty"'), delete_marker(data_rows.should_delete), delete_not_found(data_rows,'ignore'),
       data_rows.summary,
       data_rows.last_activity,
       data_rows.usage_input_tokens,
       data_rows.usage_output_tokens,
       data_rows.usage_embedding_tokens,
       data_rows.created_at,
       data_rows.updated_at,
       data_rows.created_by_user_id,
       data_rows.agent_id,
       data_rows.default_model_provider,
       data_rows.default_model,
       data_rows.default_model_params,
       data_rows.title,
       data_rows.conversation_parent_id,
       data_rows.conversation_parent_turn_id,
       data_rows.metadata,
       data_rows.visibility,
       data_rows.shareable,
       data_rows.status,
       data_rows.scheduled,
       data_rows.schedule_id,
       data_rows.schedule_run_id,
       data_rows.schedule_kind,
       data_rows.schedule_timezone,
       data_rows.schedule_cron_expr,
       data_rows.external_task_ref,
       type(data_rows,'MutableConversationView'),
       lifecycle_type(data_rows,'Lifecycle'),
       CAST(data_rows.id AS string),
       tag(data_rows.id,'validate:"required" sqlx:"id,primaryKey"'),
       CAST(data_rows.summary AS *string),
       tag(data_rows.summary,'json:",omitempty" sqlx:"summary"'),
       CAST(data_rows.last_activity AS *time.Time),
       tag(data_rows.last_activity,'json:",omitempty" sqlx:"last_activity"'),
       CAST(data_rows.usage_input_tokens AS *int),
       tag(data_rows.usage_input_tokens,'json:",omitempty" sqlx:"usage_input_tokens"'),
       CAST(data_rows.usage_output_tokens AS *int),
       tag(data_rows.usage_output_tokens,'json:",omitempty" sqlx:"usage_output_tokens"'),
       CAST(data_rows.usage_embedding_tokens AS *int),
       tag(data_rows.usage_embedding_tokens,'json:",omitempty" sqlx:"usage_embedding_tokens"'),
       CAST(data_rows.created_at AS *time.Time),
       tag(data_rows.created_at,'json:",omitempty" sqlx:"created_at"'),
       CAST(data_rows.updated_at AS *time.Time),
       tag(data_rows.updated_at,'json:",omitempty" sqlx:"updated_at"'),
       CAST(data_rows.created_by_user_id AS *string),
       tag(data_rows.created_by_user_id,'json:",omitempty" sqlx:"created_by_user_id"'),
       CAST(data_rows.agent_id AS *string),
       tag(data_rows.agent_id,'json:",omitempty" sqlx:"agent_id"'),
       CAST(data_rows.default_model_provider AS *string),
       tag(data_rows.default_model_provider,'json:",omitempty" sqlx:"default_model_provider"'),
       CAST(data_rows.default_model AS *string),
       tag(data_rows.default_model,'json:",omitempty" sqlx:"default_model"'),
       CAST(data_rows.default_model_params AS *string),
       tag(data_rows.default_model_params,'json:",omitempty" sqlx:"default_model_params"'),
       CAST(data_rows.title AS *string),
       tag(data_rows.title,'json:",omitempty" sqlx:"title"'),
       CAST(data_rows.conversation_parent_id AS *string),
       tag(data_rows.conversation_parent_id,'json:",omitempty" sqlx:"conversation_parent_id"'),
       CAST(data_rows.conversation_parent_turn_id AS *string),
       tag(data_rows.conversation_parent_turn_id,'json:",omitempty" sqlx:"conversation_parent_turn_id"'),
       CAST(data_rows.metadata AS *string),
       tag(data_rows.metadata,'json:",omitempty" sqlx:"metadata"'),
       CAST(data_rows.visibility AS *string),
       tag(data_rows.visibility,'json:",omitempty" sqlx:"visibility"'),
       CAST(data_rows.shareable AS int),
       tag(data_rows.shareable,'json:",omitempty" sqlx:"shareable"'),
       CAST(data_rows.status AS *string),
       tag(data_rows.status,'json:",omitempty" sqlx:"status"'),
       CAST(data_rows.scheduled AS *int),
       tag(data_rows.scheduled,'json:",omitempty" sqlx:"scheduled"'),
       CAST(data_rows.schedule_id AS *string),
       tag(data_rows.schedule_id,'json:",omitempty" sqlx:"schedule_id"'),
       CAST(data_rows.schedule_run_id AS *string),
       tag(data_rows.schedule_run_id,'json:",omitempty" sqlx:"schedule_run_id"'),
       CAST(data_rows.schedule_kind AS *string),
       tag(data_rows.schedule_kind,'json:",omitempty" sqlx:"schedule_kind"'),
       CAST(data_rows.schedule_timezone AS *string),
       tag(data_rows.schedule_timezone,'json:",omitempty" sqlx:"schedule_timezone"'),
       CAST(data_rows.schedule_cron_expr AS *string),
       tag(data_rows.schedule_cron_expr,'json:",omitempty" sqlx:"schedule_cron_expr"'),
       CAST(data_rows.external_task_ref AS *string),
       tag(data_rows.external_task_ref,'json:",omitempty" sqlx:"external_task_ref"')
FROM (SELECT `id`, `summary`, `last_activity`, `usage_input_tokens`, `usage_output_tokens`, `usage_embedding_tokens`, `created_at`, `updated_at`, `created_by_user_id`, `agent_id`, `default_model_provider`, `default_model`, `default_model_params`, `title`, `conversation_parent_id`, `conversation_parent_turn_id`, `metadata`, `visibility`, `shareable`, `status`, `scheduled`, `schedule_id`, `schedule_run_id`, `schedule_kind`, `schedule_timezone`, `schedule_cron_expr`, `external_task_ref`, 0 AS should_delete FROM conversation) data_rows
