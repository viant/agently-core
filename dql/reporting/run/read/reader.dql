#package('github.com/viant/agently-core/internal/datly/reporting/run/read')
#import('time','time')
#import('predicate','github.com/viant/agently-core/internal/datly/predicate')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/forge/reporting/run','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Internal<bool>(reportAccess/internal).Required())
#define($_ = $OwnerSubject<*string>(visibility/subject).Required())
#define($_ = $ReportRunID<string>(query/reportRunId).Optional().WithPredicate(0,'equal','r','report_run_id'))
#define($_ = $ReportRunIDs<[]string>(query/reportRunIds).Optional().WithPredicate(0,'in','r','report_run_id'))
#define($_ = $UIRunRequestID<string>(query/uiRunRequestId).Optional().WithPredicate(0,'equal','r','ui_run_request_id'))
#define($_ = $ConversationID<string>(query/conversationId).Optional().WithPredicate(0,'equal','r','conversation_id'))
#define($_ = $ConversationIDs<[]string>(query/conversationIds).Optional().WithPredicate(0,'in','r','conversation_id'))
#define($_ = $OwnerID<string>(query/ownerId).Optional().WithPredicate(0,'equal','r','owner_id'))
#define($_ = $Status<string>(query/status).Optional().WithPredicate(0,'equal','r','status'))
#define($_ = $Origin<string>(query/origin).Optional().WithPredicate(0,'equal','r','origin'))
#define($_ = $TechnicalRetention<*predicate.TechnicalRetention>(technicalMaintenance/policy).Optional().WithPredicate(0,'handler','predicate.TechnicalReportRunRetention'))
#define($_ = $Data<[]*Run>(output/view).WithTag('view:"reader,selectorProjection=true,selectorLimit=true,selectorOrderBy=true"'))

SELECT data_rows.*,
       row_lock(data_rows,'report_run r'),
       CAST(data_rows.maintenance_observed_at AS string),
       internal(data_rows.maintenance_observed_at),
       tag(data_rows.maintenance_observed_at,'json:"-"'),
       type(data_rows,'Run'),
       required(data_rows.report_run_id),
       required(data_rows.owner_id),
       CAST(data_rows.conversation_id AS string),
       required(data_rows.materializer),
       CAST(data_rows.origin AS string),
       CAST(data_rows.builder_ref AS string),
       CAST(data_rows.preset_id AS string),
       CAST(data_rows.source_kind AS string),
       CAST(data_rows.source_id AS string),
       CAST(data_rows.requested_params_json AS []byte),
       CAST(data_rows.effective_params_json AS []byte),
       required(data_rows.status),
       CAST(data_rows.failure_code AS string),
       CAST(data_rows.failure_text AS string),
       required(data_rows.started_at),
       CAST(data_rows.revision AS int64),
       required(data_rows.ui_run_request_id),
       CAST(data_rows.report_spec_json AS []byte),
       CAST(data_rows.report_fill_json AS []byte),
       CAST(data_rows.report_print_json AS []byte),
       CAST(data_rows.activation_source AS string),
       CAST(data_rows.adoption_source AS string),
       CAST(data_rows.actor_id AS string),
       required(data_rows.created_at),
       required(data_rows.updated_at)
FROM (${embed:sql/run.sql}) data_rows
