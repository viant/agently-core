#package('github.com/viant/agently-core/internal/datly/reporting/job/read')
#import('time','time')
#import('predicate','github.com/viant/agently-core/internal/datly/predicate')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/forge/reporting/job','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Internal<bool>(reportAccess/internal).Required())
#define($_ = $OwnerSubject<*string>(visibility/subject).Required())
#define($_ = $JobID<string>(query/jobId).Optional().WithPredicate(0,'equal','j','job_id'))
#define($_ = $JobIDs<[]string>(query/jobIds).Optional().WithPredicate(0,'in','j','job_id'))
#define($_ = $OwnerID<string>(query/ownerId).Optional().WithPredicate(0,'equal','j','owner_id'))
#define($_ = $ConversationID<string>(query/conversationId).Optional().WithPredicate(0,'equal','j','conversation_id'))
#define($_ = $ConversationIDs<[]string>(query/conversationIds).Optional().WithPredicate(0,'in','j','conversation_id'))
#define($_ = $ReportRunID<string>(query/reportRunId).Optional().WithPredicate(0,'equal','j','report_run_id'))
#define($_ = $ReportRunIDs<[]string>(query/reportRunIds).Optional().WithPredicate(0,'in','j','report_run_id'))
#define($_ = $ExportRequestID<string>(query/exportRequestId).Optional().WithPredicate(0,'equal','j','export_request_id'))
#define($_ = $ArtifactRef<string>(query/artifactRef).Optional().WithPredicate(0,'equal','j','artifact_ref'))
#define($_ = $Status<string>(query/status).Optional().WithPredicate(0,'equal','j','status'))
#define($_ = $TechnicalRetention<*predicate.TechnicalRetention>(technicalMaintenance/policy).Optional().WithPredicate(0,'handler','predicate.TechnicalReportJobRetention'))
#define($_ = $LockRows<bool>(reportAccess/lock).Optional())
#define($_ = $Data<[]*Job>(output/view).WithTag('view:"reader,selectorProjection=true,selectorLimit=true,selectorOrderBy=true"'))

SELECT data_rows.maintenance_observed_at,
       CAST(data_rows.maintenance_observed_at AS string), internal(data_rows.maintenance_observed_at), tag(data_rows.maintenance_observed_at,'json:"-"'),
       data_rows.job_id, data_rows.artifact_ref, data_rows.owner_id,
       data_rows.conversation_id, data_rows.workspace_id, data_rows.auth_context_ref,
       data_rows.format, data_rows.scope, data_rows.status, data_rows.report_spec_json,
       data_rows.report_fill_json, data_rows.report_print_json, data_rows.metadata_json,
       data_rows.artifact_id, data_rows.error_text, data_rows.diagnostics_json,
       data_rows.submitted_at, data_rows.started_at, data_rows.completed_at,
       data_rows.retention_ttl_sec, data_rows.report_run_id, data_rows.report_run_revision,
       data_rows.export_request_id,
       type(data_rows,'Job'),
       CAST(data_rows.job_id AS string),
       CAST(data_rows.artifact_ref AS string),
       CAST(data_rows.owner_id AS string),
       CAST(data_rows.conversation_id AS string),
       CAST(data_rows.workspace_id AS string),
       CAST(data_rows.auth_context_ref AS string),
       CAST(data_rows.format AS string),
       CAST(data_rows.scope AS string),
       CAST(data_rows.status AS string),
       CAST(data_rows.report_spec_json AS []byte),
       CAST(data_rows.report_fill_json AS []byte),
       CAST(data_rows.report_print_json AS []byte),
       CAST(data_rows.metadata_json AS []byte),
       CAST(data_rows.artifact_id AS string),
       CAST(data_rows.error_text AS string),
       CAST(data_rows.diagnostics_json AS []byte),
       CAST(data_rows.submitted_at AS time.Time),
       CAST(data_rows.started_at AS *time.Time),
       CAST(data_rows.completed_at AS *time.Time),
       CAST(data_rows.retention_ttl_sec AS int64),
       CAST(data_rows.report_run_id AS string),
       CAST(data_rows.report_run_revision AS int64),
       CAST(data_rows.export_request_id AS string)
FROM (
    SELECT CAST(COALESCE(j.completed_at,j.started_at,j.submitted_at) AS CHAR) AS maintenance_observed_at, j.job_id, j.artifact_ref, j.owner_id,
           COALESCE(j.conversation_id,'') AS conversation_id,
           COALESCE(j.workspace_id,'') AS workspace_id,
           COALESCE(j.auth_context_ref,'') AS auth_context_ref,
           j.format, j.scope, j.status, j.report_spec_json,
           j.report_fill_json, j.report_print_json, j.metadata_json,
           COALESCE(j.artifact_id,'') AS artifact_id,
           COALESCE(j.error_text,'') AS error_text, j.diagnostics_json,
           j.submitted_at, j.started_at, j.completed_at,
           j.retention_ttl_sec, COALESCE(j.report_run_id,'') AS report_run_id,
           COALESCE(j.report_run_revision,0) AS report_run_revision,
           COALESCE(j.export_request_id,'') AS export_request_id
    FROM report_export_job j
    WHERE ($Internal OR j.owner_id = $OwnerSubject)
    ${predicate.Builder().CombineOr($predicate.FilterGroup(0, "AND")).Build("AND")}
    ORDER BY j.submitted_at DESC, j.job_id DESC
 #if($LockRows) ${View.ForUpdate()} #end
) data_rows
