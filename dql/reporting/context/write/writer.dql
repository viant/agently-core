#package('github.com/viant/agently-core/internal/datly/reporting/context/write')
#import('time','time')
#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/internal/forge/reporting/conversation-context','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Internal<bool>(reportAccess/internal).Required())
#define($_ = $OwnerSubject<*string>(visibility/subject).Required())
#define($_ = $DesiredRevision<int64>(query/desiredRevision).Optional())
#define($_ = $Contexts<[]*Context>(body/data))
#define($_ = $Data<[]*Context>(output/body))

SELECT data_rows.owner_id, data_rows.conversation_id, data_rows.should_delete,
       CAST(data_rows.should_delete AS bool), tag(data_rows.should_delete,'json:"shouldDelete,omitempty"'), delete_marker(data_rows.should_delete), delete_not_found(data_rows,'error'),
       data_rows.active_report_run_id,
       data_rows.revision,
       data_rows.activation_source,
       data_rows.actor_id,
       data_rows.updated_at,
       type(data_rows,'Context'), lifecycle_type(data_rows,'Lifecycle'), concurrency_token(data_rows.revision),
       CAST(data_rows.owner_id AS string), tag(data_rows.owner_id,'sqlx:"owner_id,primaryKey=true,required=true"'),
       CAST(data_rows.conversation_id AS string), tag(data_rows.conversation_id,'sqlx:"conversation_id,primaryKey=true,required=true"'),
       CAST(data_rows.active_report_run_id AS string), tag(data_rows.active_report_run_id,'sqlx:"active_report_run_id,required=true"'),
       CAST(data_rows.revision AS int64), tag(data_rows.revision,'sqlx:"revision,required=true"'),
       CAST(data_rows.activation_source AS string), tag(data_rows.activation_source,'sqlx:"activation_source,required=true"'),
       CAST(data_rows.actor_id AS string), tag(data_rows.actor_id,'sqlx:"actor_id,required=true"'),
       CAST(data_rows.updated_at AS time.Time), tag(data_rows.updated_at,'sqlx:"updated_at,required=true"')
FROM (
    SELECT 0 AS should_delete, owner_id, conversation_id, active_report_run_id,
           revision, activation_source, actor_id, updated_at
    FROM conversation_report_context
) data_rows
