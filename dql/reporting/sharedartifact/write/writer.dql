#package('github.com/viant/agently-core/internal/datly/reporting/sharedartifact/write')
#import('time','time')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/forge/reporting/shared-artifact','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#define($_ = $Internal<bool>(artifactAccess/internal).Required())
#define($_ = $WriteIntent<string>(query/intent).Optional())
#define($_ = $OwnerSubject<*string>(visibility/subject).Optional().WithPredicate(9,'equal','report_shared_artifact','owner_id'))
#define($_ = $Artifact<*SharedArtifact>(body/data))
#define($_ = $Data<*SharedArtifact>(output/body))

SELECT data_rows.artifact_id, data_rows.should_delete,
       CAST(data_rows.should_delete AS bool), tag(data_rows.should_delete,'json:"shouldDelete,omitempty"'), delete_marker(data_rows.should_delete),
       data_rows.artifact_ref,
       data_rows.owner_id,
       data_rows.owner_ref,
       data_rows.kind,
       data_rows.lifecycle,
       data_rows.version,
       data_rows.report_id,
       data_rows.title,
       data_rows.source_artifact_id,
       data_rows.base_artifact_ref,
       data_rows.policy_ref,
       data_rows.document_version,
       data_rows.report_document_json,
       data_rows.report_spec_json,
       data_rows.compile_state_json,
       data_rows.report_fill_json,
       data_rows.report_print_json,
       data_rows.saved_view_overlay_json,
       data_rows.metadata_json,
       data_rows.created_at,
       data_rows.updated_at,
       type(data_rows,'SharedArtifact'), lifecycle_type(data_rows,'Lifecycle'), mutation_predicate(data_rows,9),
       CAST(data_rows.artifact_id AS string),
       tag(data_rows.artifact_id,'json:"artifactId,omitempty" sqlx:"artifact_id,primaryKey"'),
       CAST(data_rows.artifact_ref AS string),
       tag(data_rows.artifact_ref,'json:"artifactRef,omitempty" sqlx:"artifact_ref"'),
       CAST(data_rows.owner_id AS string),
       tag(data_rows.owner_id,'json:"ownerId,omitempty" sqlx:"owner_id"'),
       CAST(data_rows.owner_ref AS string),
       tag(data_rows.owner_ref,'json:"ownerRef,omitempty" sqlx:"owner_ref"'),
       CAST(data_rows.kind AS string),
       tag(data_rows.kind,'json:"kind,omitempty" sqlx:"kind"'),
       CAST(data_rows.lifecycle AS string),
       tag(data_rows.lifecycle,'json:"lifecycle,omitempty" sqlx:"lifecycle"'),
       CAST(data_rows.version AS int),
       tag(data_rows.version,'json:"version,omitempty" sqlx:"version"'),
       CAST(data_rows.report_id AS string),
       tag(data_rows.report_id,'json:"reportId,omitempty" sqlx:"report_id"'),
       CAST(data_rows.title AS string),
       tag(data_rows.title,'json:"title,omitempty" sqlx:"title"'),
       CAST(data_rows.source_artifact_id AS string),
       tag(data_rows.source_artifact_id,'json:"sourceArtifactId,omitempty" sqlx:"source_artifact_id"'),
       CAST(data_rows.base_artifact_ref AS string),
       tag(data_rows.base_artifact_ref,'json:"baseArtifactRef,omitempty" sqlx:"base_artifact_ref"'),
       CAST(data_rows.policy_ref AS string),
       tag(data_rows.policy_ref,'json:"policyRef,omitempty" sqlx:"policy_ref"'),
       CAST(data_rows.document_version AS int),
       tag(data_rows.document_version,'json:"documentVersion,omitempty" sqlx:"document_version"'),
       CAST(data_rows.report_document_json AS []byte),
       tag(data_rows.report_document_json,'json:"document,omitempty" sqlx:"report_document_json"'),
       CAST(data_rows.report_spec_json AS []byte),
       tag(data_rows.report_spec_json,'json:"reportSpec,omitempty" sqlx:"report_spec_json"'),
       CAST(data_rows.compile_state_json AS []byte),
       tag(data_rows.compile_state_json,'json:"compileState,omitempty" sqlx:"compile_state_json"'),
       CAST(data_rows.report_fill_json AS []byte),
       tag(data_rows.report_fill_json,'json:"reportFill,omitempty" sqlx:"report_fill_json"'),
       CAST(data_rows.report_print_json AS []byte),
       tag(data_rows.report_print_json,'json:"reportPrint,omitempty" sqlx:"report_print_json"'),
       CAST(data_rows.saved_view_overlay_json AS []byte),
       tag(data_rows.saved_view_overlay_json,'json:"savedViewOverlay,omitempty" sqlx:"saved_view_overlay_json"'),
       CAST(data_rows.metadata_json AS []byte),
       tag(data_rows.metadata_json,'json:"metadata,omitempty" sqlx:"metadata_json"'),
       CAST(data_rows.created_at AS time.Time),
       tag(data_rows.created_at,'json:"createdAt,omitempty" sqlx:"created_at"'),
       CAST(data_rows.updated_at AS *time.Time),
       tag(data_rows.updated_at,'json:"updatedAt,omitempty" sqlx:"updated_at"')
FROM (SELECT 0 AS should_delete, `artifact_id`, `artifact_ref`, `owner_id`, COALESCE(`owner_ref`, '') AS `owner_ref`, `kind`, `lifecycle`, `version`, COALESCE(`report_id`, '') AS `report_id`, COALESCE(`title`, '') AS `title`, COALESCE(`source_artifact_id`, '') AS `source_artifact_id`, COALESCE(`base_artifact_ref`, '') AS `base_artifact_ref`, COALESCE(`policy_ref`, '') AS `policy_ref`, `document_version`, `report_document_json`, `report_spec_json`, `compile_state_json`, `report_fill_json`, `report_print_json`, `saved_view_overlay_json`, `metadata_json`, `created_at`, `updated_at` FROM report_shared_artifact) data_rows
