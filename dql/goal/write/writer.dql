#package('github.com/viant/agently-core/internal/datly/goal/write')

#setting($_ = $connector('agently'))
#setting($_ = $internal(true))
#setting($_ = $route('/v1/api/agently/goal','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $writer_omit_empty(true))
#define($_ = $Status<?>(output/status).WithTag('anonymous:"true"'))
#define($_ = $Goals<[]*Goal>(body/data))
#define($_ = $Data<[]*Goal>(output/body))

SELECT t.*,
       CAST(t.should_delete AS bool),
       delete_marker(t.should_delete),
       delete_not_found(t,'ignore'),
       type(t,'Goal'),
       lifecycle_type(t,'Lifecycle'),
       required(t.id),
       tag(t.id,'validate:"required" sqlx:"id,primaryKey"'),
       CAST(t.token_budget AS *int64),
       CAST(t.tokens_used AS *int64),
       CAST(t.time_used_seconds AS *int64),
       CAST(t.autonomous_turns_used AS *int64),
       CAST(t.consecutive_no_progress AS *int64),
       tag(t.id,'json:","')
FROM (${embed:sql/goal.sql}) t
