{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://agently.dev/ag-ui/invocation-v1.schema.json",
 "title":"Agently framework-owned native invocation registration checkpoint",
 "description":"CUSTOM agently.invocation. Produced by trusted native registration, not accepted through the generic standard runtime bridge. Registration does not claim native execution started.",
 "type":"object","required":["version","phase","invocation"],"additionalProperties":false,
 "properties":{
  "version":{"const":"1"},"phase":{"const":"registered"},
  "invocation":{
   "type":"object","required":["id","conversationId","turnId","name","parentConversationId","parentTurnId"],"additionalProperties":false,
   "properties":{
    "id":{"type":"string","minLength":1},"conversationId":{"type":"string","minLength":1},"turnId":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},
    "parentConversationId":{"type":"string","minLength":1},"parentTurnId":{"type":"string","minLength":1},
    "executionMode":{"type":"string"},"detached":{"const":false},"description":{"type":"string"},"parentToolCallId":{"type":"string"},"parentMessageId":{"type":"string"},"parentInvocationId":{"type":"string"}
   }
  }
 }
}
